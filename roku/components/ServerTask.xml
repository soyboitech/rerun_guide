    <field id="request" type="assocarray" />
    <field id="response" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/core/Lang.brs" />
  <script type="text/brightscript" uri="pkg:/components/core/Time.brs" />
  <script type="text/brightscript" uri="pkg:/components/core/Models.brs" />
  <script type="text/brightscript" uri="pkg:/components/core/TitleSearch.brs" />
  <script type="text/brightscript" uri="pkg:/components/core/Duplicates.brs" />
  <script type="text/brightscript" uri="pkg:/components/app/Store.brs" />
  <script type="text/brightscript" uri="pkg:/components/server/Http.brs" />
  <script type="text/brightscript" uri="pkg:/components/server/Plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/server/Jellyfin.brs" />
  <script type="text/brightscript" uri="pkg:/components/ServerTask.brs" />
</component>
